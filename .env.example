# Private dashboard at /me. The public portfolio builds and runs without any of these.

# Postgres connection string (added automatically by the Neon integration in Vercel).
# For local development without a database server, use an embedded one: DATABASE_URL=pglite:./.pglite
DATABASE_URL=

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# GitHub OAuth app. Callback URL: https://www.cactobyte.tech/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Numeric GitHub user ID of the only account allowed in
OWNER_GITHUB_ID=54995353

# Bearer token for /api/leads, used by the daily outreach sessions
LEADS_API_TOKEN=
